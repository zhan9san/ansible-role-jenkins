# Reference:
# https://www.jenkins.io/doc/book/system-administration/reverse-proxy-configuration-nginx/

upstream jenkins {
  keepalive 32; # keepalive connections
  server 127.0.0.1:8080; # jenkins ip and port
}

# Required for Jenkins websocket agents
map $http_upgrade $connection_upgrade {
  default upgrade;
  '' close;
}
{% if jenkins_api_max_depth | int >= 0 %}
{% set api_max_depth = jenkins_api_max_depth | int %}

# Flag <path>/api/(json|xml|python)?depth=N when N > {{ api_max_depth }}.
# Scoped to /api/ because the UI itself calls e.g. itemCategories?depth=3.
map "$uri:$arg_depth" $jenkins_api_depth_exceeded {
  default 0;
  "~/api/(json|xml|python)/?:0*({% if api_max_depth < 9 %}[{{ api_max_depth + 1 }}-9]|{% endif %}[1-9][0-9]+)$" 1;
}
{% endif %}
{% if jenkins_api_rate_limit %}

# Rate limit <path>/api/(json|xml|python) per client IP; an empty key is not limited
map $uri $jenkins_api_client {
  default "";
  "~/api/(json|xml|python)/?$" $binary_remote_addr;
}
limit_req_zone $jenkins_api_client zone=jenkins_api:10m rate={{ jenkins_api_rate_limit }};
{% endif %}

{% if jenkins_ssl_enabled %}
server {
  listen 80;
  server_name {{ jenkins_server_name }};
  return 301 https://$host$request_uri;
}
{% endif %}
server {
  {% if jenkins_ssl_enabled %}
  listen          443 ssl;       # Listen on port 80 for IPv4 requests
  ssl_certificate      /etc/ssl/certs/{{ jenkins_ssl_cert }};
  ssl_certificate_key  /etc/ssl/private/{{ jenkins_ssl_key }};
  {% else %}
  listen          80;
  {% endif %}
  server_name     {{ jenkins_server_name }};

  # this is the jenkins web root directory
  # (mentioned in the output of "systemctl cat jenkins")
  root            {{ jenkins_webroot_directory }};

  access_log      /var/log/nginx/jenkins.access.log;
  error_log       /var/log/nginx/jenkins.error.log;

  # pass through headers from Jenkins that Nginx considers invalid
  ignore_invalid_headers off;
{% if jenkins_api_max_depth | int >= 0 %}

  # Deep ?depth= loads every job/build into memory; clients should use ?tree= instead
  if ($jenkins_api_depth_exceeded) {
    return 400 "depth > {{ jenkins_api_max_depth | int }} is not allowed on the remote API, use ?tree= instead\n";
  }
{% endif %}
{% if jenkins_api_rate_limit %}

  limit_req zone=jenkins_api burst={{ jenkins_api_rate_limit_burst }} nodelay;
  limit_req_status 429;
{% endif %}

  location ~ "^/static/[0-9a-fA-F]{8}\/(.*)$" {
    # rewrite all static files into requests to the root
    # E.g /static/12345678/css/something.css will become /css/something.css
    rewrite "^/static/[0-9a-fA-F]{8}\/(.*)" /$1 last;
  }

  location /userContent {
    # have nginx handle all the static requests to userContent folder
    # note : This is the $JENKINS_HOME dir
    root /var/lib/jenkins/;
    if (!-f $request_filename){
      # this file does not exist, might be a directory or a /**view** url
      rewrite (.*) /$1 last;
      break;
    }
    sendfile on;
  }

  location / {
      sendfile off;
      proxy_pass         http://jenkins;
      proxy_redirect     default;
      proxy_http_version 1.1;

      # Required for Jenkins websocket agents
      proxy_set_header   Connection        $connection_upgrade;
      proxy_set_header   Upgrade           $http_upgrade;

      proxy_set_header   Host              $host;
      proxy_set_header   X-Real-IP         $remote_addr;
      proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
      proxy_set_header   X-Forwarded-Proto $scheme;
      proxy_max_temp_file_size 0;

      #this is the maximum upload size
      client_max_body_size       10m;
      client_body_buffer_size    128k;

      proxy_connect_timeout      90;
      proxy_send_timeout         90;
      proxy_read_timeout         90;
      proxy_buffering            off;
      proxy_request_buffering    off; # Required for HTTP CLI commands
      proxy_set_header Connection ""; # Clear for keepalive
  }
}
